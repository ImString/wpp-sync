{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": [".env", ".env.development", ".env.production", "**/.env.*local"],
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"dependsOn": ["^build"]
		},
		"build:dev": {
			"outputs": ["dist/**"],
			"dependsOn": ["^build:dev"]
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["build", "^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.local", ".env.production"],
			"passThroughEnv": ["PORT", "SERVER_FULL_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build:dev"],
			"inputs": ["$TURBO_DEFAULT$", ".env.local", ".env.development"],
			"passThroughEnv": ["PORT", "SERVER_FULL_URL"]
		},
		"db:generate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:push:dev": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:studio:dev": {
			"cache": false,
			"persistent": true
		}
	}
}
