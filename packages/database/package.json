{
	"name": "@wppsync/database",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "dotenvx run -f ../../.env -- prisma generate && tsc -p tsconfig.json",
		"build:dev": "dotenvx run -f ../../.env.development -- prisma generate && tsc -p tsconfig.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"db:generate": "dotenvx run -f ../../.env -- prisma generate",
		"db:push": "dotenvx run -f ../../.env -- prisma db push",
		"db:push:dev": "dotenvx run -f ../../.env.development -- prisma db push",
		"db:studio": "dotenvx run -f ../../.env -- prisma studio",
		"db:studio:dev": "dotenvx run -f ../../.env.development -- prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.34.0",
		"@wppsync/config": "workspace:*",
		"@types/pg": "^8.20.0",
		"prisma": "^7.9.0",
		"typescript": "^7.0.2"
	}
}
