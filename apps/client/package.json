{
	"name": "@wppsync/client",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.json && vite build",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "dotenvx run -f ../../.env.development -- vite --host 0.0.0.0",
		"start": "dotenvx run -f ../../.env -- vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.75.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@wppsync/config": "workspace:*",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	}
}
