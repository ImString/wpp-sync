{
	"name": "@wppsync/server",
	"main": "./dist/core/index.js",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"start": "dotenvx run -f ../../.env -- node ./dist/core/index.js",
		"dev": "dotenvx run -f ../../.env.development -- ztsc --watch ./src/core/index.ts"
	},
	"keywords": [],
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1095.0",
		"@aws-sdk/s3-request-presigner": "^3.1095.0",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/multipart": "^10.1.0",
		"@wppsync/backend": "workspace:*",
		"@wppsync/database": "workspace:*",
		"@wppsync/shared": "workspace:*",
		"ansicolor": "^2.0.3",
		"bcrypt": "^6.0.0",
		"bullmq": "^6.0.8",
		"cacheable": "^2.5.0",
		"fastify": "^5.10.0",
		"ioredis": "^5.0.0",
		"jsonwebtoken": "^9.0.3",
		"reflect-metadata": "0.2.2",
		"sharp": "^0.35.3",
		"socket.io": "^4.8.3",
		"sqids": "^0.3.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.34.0",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.1",
		"@wppsync/config": "workspace:*",
		"tsc-alias": "1.8.16",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
