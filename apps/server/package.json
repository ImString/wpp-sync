{
	"name": "@wppsync/server",
	"main": "./dist/core/index.js",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"start": "dotenvx run -f ../../.env -- node ./dist/core/index.js",
		"dev": "dotenvx run -f ../../.env.development -- node --watch --import tsx ./src/core/index.ts"
	},
	"keywords": [],
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/multipart": "^10.1.0",
		"@wppsync/database": "workspace:*",
		"@wppsync/shared": "workspace:*",
		"ansicolor": "^2.0.3",
		"fastify": "^5.10.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.34.0",
		"@types/node": "^26.1.1",
		"@wppsync/config": "workspace:*",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
