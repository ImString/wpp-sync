MODE='production' # development | production

# Client
PORT=3005
CLIENT_FULL_URL='http://localhost:3005'
VITE_API_URL='http://localhost:3001'

VITE_AUTH_TOKEN_STORAGE_NAME='WPP.Auth-Token'
VITE_REFRESH_TOKEN_STORAGE_NAME='WPP.Refresh-Token'

# Server
SERVER_PORT=3001
SERVER_FULL_URL='http://localhost:3001'

# Server - Authenticator
JWT_SECRET='JWT-TOKEN-SECRET'
SESSION_TOKEN_AUTH_TIMEOUT='1h'
SESSION_TOKEN_REFRESH_TIMEOUT='30d'

# Server - Google
GOOGLE_CLIENT_ID='google-client-id'
GOOGLE_CLIENT_SECRET='google-client-secret'

# Server - Cloudflare
CLOUDFLARE_ACCOUNT_ID=''
CLOUDFLARE_R2_BUCKET=''
CLOUDFLARE_R2_TOKEN=''
CLOUDFLARE_R2_KEY_ID=''
CLOUDFLARE_R2_KEY_SECRET=''

# Server - Redis
REDIS_DB=1
REDIS_BULL_DB=2
REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
REDIS_USERNAME=''
REDIS_PASSWORD=''

# Kafka Docker

# ! Aviso sobre o KAFKA_CLUSTER_ID !
# Pode ser substituído por outro ID KRaft válido antes do primeiro `docker compose up`.
# Gere online selecionando UUID v4 no formato Base64 URL-safe (22 caracteres):
# https://domainscan.in/dev/generate-uuid
# Ou gere pela imagem oficial do Kafka:
# docker run --rm --entrypoint /opt/kafka/bin/kafka-storage.sh apache/kafka:4.3.1 random-uuid
# Após a criação do volume do Kafka, mantenha este valor para preservar os metadados do cluster.

KAFKA_HOST='127.0.0.1'
KAFKA_PORT=9092
KAFKA_CLUSTER_ID='6A87UpVQQeicm8Ctb-kljQ'
KAFKA_BROKERS="${KAFKA_HOST}:${KAFKA_PORT}"
KAFKA_CLIENT_ID='wpp-whatsapp-instance'

# Postgres Docker
POSTGRES_DB='chat'
POSTGRES_USER='chat_user'
POSTGRES_PASSWORD='suasenha'
POSTGRES_PORT=5432

# Database Connection
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"
